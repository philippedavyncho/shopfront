---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Mes informations — YATTE"><section class="shell account-page"><a class="text-link" href="/compte">← Mon espace</a><p class="eyebrow account-eyebrow">VOTRE PROFIL</p><h1>Les bonnes<br /><em>informations.</em></h1><form class="contact-card account-form" data-profile-form><label>Prénom<input name="first_name" autocomplete="given-name" required /></label><label>Nom<input name="last_name" autocomplete="family-name" required /></label><label>Nom d'utilisateur<input name="username" autocomplete="username" required /></label><label>Adresse e-mail<input name="email" type="email" readonly /></label><button class="button button-dark" type="submit">Enregistrer mes informations <span>→</span></button><p class="form-message" aria-live="polite"></p></form></section>
<script>
const form = document.querySelector<HTMLFormElement>('[data-profile-form]');
fetch('/api/auth/me', { cache: 'no-store' }).then(r => { if (r.status === 401) { window.location.replace('/connexion?next=%2Fcompte%2Fcoordonnees'); return Promise.reject(); } return r.ok ? r.json() : Promise.reject(); }).then(user => { for (const field of ['first_name','last_name','username','email']) { const input = form?.elements.namedItem(field) as HTMLInputElement | null; if (input) input.value = user[field] || ''; } }).catch(() => { if (form) form.querySelector<HTMLElement>('.form-message')!.textContent = 'Impossible de charger votre profil.'; });
form?.addEventListener('submit', async event => { event.preventDefault(); const data = Object.fromEntries(new FormData(form).entries()); const response = await fetch('/api/auth/me', { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) }); form.querySelector<HTMLElement>('.form-message')!.textContent = response.ok ? 'Vos informations ont été enregistrées.' : 'Impossible d’enregistrer vos informations.'; });
</script>
</BaseLayout>
