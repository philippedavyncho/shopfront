---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Mes commandes — YATTE"><section class="shell account-page"><a class="text-link" href="/compte">← Mon espace</a><p class="eyebrow account-eyebrow">VOTRE HISTOIRE AVEC NOUS</p><h1>Les trouvailles<br /><em>en chemin.</em></h1><div class="orders-list" data-orders-list><p>Chargement de vos commandes…</p></div></section>
  <script>fetch('/api/orders', { cache: 'no-store' }).then(r => { if (r.status === 401) { window.location.replace('/connexion?next=%2Fcompte%2Fcommandes'); return Promise.reject(); } return r.ok ? r.json() : Promise.reject(); }).then(data => { const orders = data.results ?? data; const root = document.querySelector<HTMLElement>('[data-orders-list]')!; root.innerHTML = orders.length ? orders.map((order: { number: string; status: string; total: string; currency: string; created_at: string }) => `<article><div><small>COMMANDE N° ${order.number}</small><strong>${new Intl.NumberFormat('fr-FR',{style:'currency',currency:order.currency,maximumFractionDigits:0}).format(Number(order.total))}</strong></div><span>${new Date(order.created_at).toLocaleDateString('fr-FR')} · ${order.status}</span></article>`).join('') : '<p>Aucune commande pour le moment. Votre première trouvaille vous attend.</p><a class="button button-dark" href="/catalogue">Explorer la boutique <span>↗</span></a>'; }).catch(() => { document.querySelector<HTMLElement>('[data-orders-list]')!.textContent = 'Impossible de charger vos commandes pour le moment.'; });</script>
</BaseLayout>
