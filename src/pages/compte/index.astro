---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Mon espace — YATTE"><section class="shell account-page"><p class="eyebrow">VOTRE PETIT COIN À VOUS</p><h1>Bonjour,<br /><em>bienvenue.</em></h1><p class="account-lede" data-account-greeting>Retrouvez vos commandes, informations et envies en un clin d'œil.</p><div class="account-grid"><a href="/compte/commandes"><span>01</span><strong>Mes commandes</strong><small>Suivre vos belles trouvailles <b>→</b></small></a><a href="/compte/coordonnees"><span>02</span><strong>Mes informations</strong><small>Vos coordonnées et préférences <b>→</b></small></a><a href="/compte/adresses"><span>03</span><strong>Mes adresses</strong><small>Les lieux où vous retrouver <b>→</b></small></a><a href="/favoris"><span>04</span><strong>Mes favoris</strong><small>Vos coups de cœur gardés <b>→</b></small></a></div><button class="text-button" data-logout>Se déconnecter <span>↗</span></button></section>
  <script>fetch('/api/auth/me', { cache: 'no-store' }).then(r => { if (r.status === 401) { window.location.replace('/connexion?next=%2Fcompte'); return null; } return r.ok ? r.json() : null; }).then(user => { if (user?.first_name) document.querySelector<HTMLElement>('[data-account-greeting]')!.textContent = `Ravi de vous retrouver, ${user.first_name}. Retrouvez vos commandes, informations et envies en un clin d'œil.`; }); document.querySelector('[data-logout]')?.addEventListener('click', async () => { await fetch('/api/auth/logout', { method: 'POST' }); window.location.assign('/'); });</script>
</BaseLayout>
