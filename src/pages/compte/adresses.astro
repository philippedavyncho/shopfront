---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Mes adresses — YATTE"><section class="shell account-page"><a class="text-link" href="/compte">← Mon espace</a><p class="eyebrow account-eyebrow">POUR VOUS RETROUVER</p><h1>Vos adresses,<br /><em>en un endroit.</em></h1><div class="address-list" data-address-list></div><form class="contact-card account-form" data-address-form><h2>Ajouter une adresse</h2><label>Nom du destinataire<input name="recipient_name" autocomplete="name" required /></label><label>Téléphone<input name="phone" type="tel" autocomplete="tel" required /></label><label>Adresse<input name="line1" autocomplete="street-address" required /></label><label>Complément<input name="line2" autocomplete="address-line2" /></label><div class="form-two"><label>Ville<input name="city" autocomplete="address-level2" required /></label><label>Région<input name="region" autocomplete="address-level1" /></label></div><label>Pays (code ISO)<input name="country" value="SN" maxlength="2" required /></label><button class="button button-dark" type="submit">Ajouter cette adresse <span>→</span></button><p class="form-message" aria-live="polite"></p></form></section>
<script>
const list = document.querySelector<HTMLElement>('[data-address-list]');
async function load(){ const response = await fetch('/api/addresses',{cache:'no-store'}); if(response.status===401){window.location.replace('/connexion?next=%2Fcompte%2Fadresses');return;} if(!response.ok) throw new Error('API indisponible'); const addresses = await response.json(); if(list) list.innerHTML = addresses.length ? addresses.map((a: {id:number;recipient_name:string;phone:string;line1:string;line2:string;city:string;country:string})=>`<article><strong>${escapeHtml(a.recipient_name)}</strong><span>${escapeHtml(a.line1)} ${escapeHtml(a.line2)}, ${escapeHtml(a.city)}, ${escapeHtml(a.country)}</span><small>${escapeHtml(a.phone)}</small><button type="button" data-delete-address="${a.id}">Supprimer</button></article>`).join('') : '<p>Aucune adresse enregistrée pour le moment.</p>'; }
function escapeHtml(v:string){return v.replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]||c));}
load().catch(()=>{if(list) list.textContent='Impossible de charger vos adresses.';});
list?.addEventListener('click',async e=>{const button=(e.target as HTMLElement).closest<HTMLButtonElement>('[data-delete-address]');if(!button)return;await fetch(`/api/addresses/${button.dataset.deleteAddress}`,{method:'DELETE'});load();});
document.querySelector<HTMLFormElement>('[data-address-form]')?.addEventListener('submit',async e=>{e.preventDefault();const form=e.currentTarget as HTMLFormElement;const response=await fetch('/api/addresses',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(Object.fromEntries(new FormData(form).entries()))});form.querySelector<HTMLElement>('.form-message')!.textContent=response.ok?'Adresse enregistrée.':'Vérifiez les informations saisies.';if(response.ok){form.reset();load();}});
</script>
</BaseLayout>
