---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCategories } from '../lib/catalog';
const categories = await getCategories();
const images = ['photo-1524758631624-e2822e304c36', 'photo-1602143407151-7111542de6e8', 'photo-1490481651871-ab68de25d43d', 'photo-1517836357463-d25dfeac3438'];
---
<BaseLayout title="Catégories | YATTE"><section class="shell site-copy"><p class="eyebrow">LES UNIVERS YATTE</p><h1>Un grand choix,<br /><em>pour tous les jours.</em></h1><p>Parcourez nos catégories : électronique, électroménager, mode, sport et plus encore.</p><div class="category-grid category-directory">{categories.map((category, index) => <a class="category-tile" href={`/catalogue?category=${encodeURIComponent(category.slug)}`}><img src={`https://images.unsplash.com/${images[index % images.length]}?auto=format&fit=crop&w=800&q=85`} alt={category.name} loading="lazy" /><span class="category-label">{category.name} <b>&#8599;</b></span></a>)}</div></section></BaseLayout>
