const { variantId, name, price, sku, slug, image, disabled = false } = Astro.props;
---
<button class="button button-primary add-to-cart" type="button" data-add-cart data-variant={variantId} data-name={name} data-price={price} data-sku={sku} data-slug={slug} data-image={image} disabled={disabled}><span>Ajouter au panier</span><span aria-hidden="true">↗</span></button>
